cat > ~/verbal-morality-ledger/server.js << 'ENDOFFILE'
import express from "express";
import cors from "cors";
import { Xumm } from "xumm";
import { createServer } from "http";
import path from "path";
import { fileURLToPath } from "url";
import dotenv from "dotenv";
dotenv.config();

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const app = express();
const server = createServer(app);

app.use(cors());
app.use(express.json());
app.use(express.static(path.join(__dirname, "public")));

const xumm = new Xumm(process.env.XAMAN_API_KEY, process.env.XAMAN_API_SECRET);

const sseClients = new Map();

app.get("/api/ping", async (req, res) => {
  try {
    const pong = await xumm.ping();
    res.json({ ok: true, app: pong.application.name });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.post("/api/signin", async (req, res) => {
  try {
    let created;
    const payload = await xumm.payload.createAndSubscribe(
      { TransactionType: "SignIn" },
      (event) => {
        const clients = sseClients.get(created?.uuid);
        if (!clients) return;
        if ("opened" in event.data) {
          clients.forEach((c) => c.write(`data: ${JSON.stringify({ type: "opened" })}\n\n`));
        }
        if ("signed" in event.data) {
          clients.forEach((c) =>
            c.write(`data: ${JSON.stringify({ type: "resolved", signed: event.data.signed })}\n\n`)
          );
          return event;
        }
      }
    );
    created = payload.created;
    res.json({
      uuid: payload.created.uuid,
      qr: payload.created.refs.qr_png,
      deeplink: payload.created.next.always,
    });
    payload.resolved.then(async (result) => {
      if (!result) return;
      const clients = sseClients.get(payload.created.uuid);
      if (!clients) return;
      const detail = await xumm.payload.get(payload.created.uuid);
      const address = detail?.response?.account;
      clients.forEach((c) => {
        c.write(`data: ${JSON.stringify({ type: "signed", address, signed: result.signed })}\n\n`);
        c.end();
      });
      sseClients.delete(payload.created.uuid);
    });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.post("/api/pay", async (req, res) => {
  const { word, userToken } = req.body;
  if (!word) return res.status(400).json({ error: "Missing word" });
  const CHARITY = process.env.CHARITY_ADDRESS || "rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh";
  try {
    let created;
    const payloadBody = {
      txjson: {
        TransactionType: "Payment",
        Destination: CHARITY,
        Amount: "100000",
        Memos: [{
          Memo: {
            MemoData: Buffer.from(`VML FINE: ${word}`, "utf8").toString("hex").toUpperCase(),
          },
        }],
      },
      options: {
        force_network: "TESTNET",
        return_url: {
          web: `${process.env.APP_URL || "http://localhost:3000"}/?paid={id}`,
        },
      },
      custom_meta: {
        identifier: `vml_fine_${Date.now()}`,
        instruction: `Verbal Morality Ledger: fine for saying "${word.toUpperCase()}". 0.1 XRP to Tourette Scotland.`,
        blob: { word },
      },
      ...(userToken ? { user_token: userToken } : {}),
    };
    const payload = await xumm.payload.createAndSubscribe(payloadBody, (event) => {
      const clients = sseClients.get(created?.uuid);
      if (!clients) return;
      if ("opened" in event.data) {
        clients.forEach((c) => c.write(`data: ${JSON.stringify({ type: "opened" })}\n\n`));
      }
      if ("signed" in event.data) {
        clients.forEach((c) =>
          c.write(`data: ${JSON.stringify({ type: "resolved", signed: event.data.signed })}\n\n`)
        );
        return event;
      }
    });
    created = payload.created;
    res.json({
      uuid: payload.created.uuid,
      qr: payload.created.refs.qr_png,
      deeplink: payload.created.next.always,
    });
    payload.resolved.then(async (result) => {
      if (!result) return;
      const clients = sseClients.get(payload.created.uuid);
      if (!clients) return;
      const detail = await xumm.payload.get(payload.created.uuid);
      const txHash = detail?.response?.txid;
      clients.forEach((c) => {
        c.write(`data: ${JSON.stringify({ type: "signed", signed: result.signed, txHash, word })}\n\n`);
        c.end();
      });
      sseClients.delete(payload.created.uuid);
    });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.get("/api/subscribe/:uuid", (req, res) => {
  const { uuid } = req.params;
  res.setHeader("Content-Type", "text/event-stream");
  res.setHeader("Cache-Control", "no-cache");
  res.setHeader("Connection", "keep-alive");
  res.flushHeaders();
  if (!sseClients.has(uuid)) sseClients.set(uuid, new Set());
  sseClients.get(uuid).add(res);
  const hb = setInterval(() => res.write(": heartbeat\n\n"), 20000);
  req.on("close", () => {
    clearInterval(hb);
    const clients = sseClients.get(uuid);
    if (clients) {
      clients.delete(res);
      if (clients.size === 0) sseClients.delete(uuid);
    }
  });
});

app.get("/api/payload/:uuid", async (req, res) => {
  try {
    const detail = await xumm.payload.get(req.params.uuid);
    res.json(detail);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.get("/api/balance/:address", async (req, res) => {
  try {
    const { Client } = await import("xrpl");
    const client = new Client("wss://s.altnet.rippletest.net:51233");
    await client.connect();
    const balance = await client.getXrpBalance(req.params.address);
    await client.disconnect();
    res.json({ balance: parseFloat(balance).toFixed(2) });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

const PORT = process.env.PORT || 3000;
server.lXisten(PORT, () => console.log(`VML server running on :${PORT}`));
ENDOFFIL
